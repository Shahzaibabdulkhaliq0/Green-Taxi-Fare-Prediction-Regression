# Separate frontend image; the FastAPI model remains in the API container.
FROM python:3.12-slim

WORKDIR /app

# Install only the frontend runtime dependencies.
COPY requirements-streamlit.txt .
RUN pip install --no-cache-dir -r requirements-streamlit.txt

# Copy the Streamlit application.
COPY app.py .

# Streamlit listens on port 8501.
EXPOSE 8501

# Start the frontend. API_BASE_URL is supplied at runtime.
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
